# Inference: ollama | openai_compatible
MODEL_BACKEND=ollama
MODEL_NAME=qwen2.5-coder:3b
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_API_KEY=
MODEL_CONTEXT_TOKENS=8192

# Tools: hermes | direct | fixture. Hermes is the production default.
TOOL_BACKEND=hermes
HERMES_COMMAND=hermes
HERMES_TIMEOUT_SECONDS=300

PUBLISH_MODE=AUTO
DAILY_PUBLISH_LIMIT=2
X_PROFILE_URL=https://x.com/your_account
THREADS_PROFILE_URL=https://www.threads.com/@your_account
MIN_IMPORTANCE=0.62
MIN_CONFIDENCE=0.70
MAX_ITERATIONS=24
MAX_SEARCHES=5
MAX_PAGE_READS=8
MAX_RETRIES=2
MAX_OBSERVATION_CHARS=3500
DATABASE_PATH=data/news_agent.db
QUEUE_PATH=data/review_queue.jsonl
TRAJECTORY_PATH=logs/trajectories.jsonl

# Generate the local Short; autonomous upload is hard-limited to PRIVATE.
YOUTUBE_DRAFTS_ENABLED=true
SHORTS_DIR=data/shorts
# Optional installed Windows SAPI voice name; blank selects the system default.
VOICE_NAME=

# Budgeted Working Memory & KV Cache optimization
MEMORY_BUDGET_NODES=12
MEMORY_CONSOLIDATION_THRESHOLD=0.75
